@{
    ViewData["Title"] = "Generate Report";
}

<div style="min-height: 100vh; background-color: #eef2f7; padding: 24px;">
    <div style="width: 100%; max-width: 980px; margin: 0 auto; background: #ffffff; padding: 24px; border-radius: 12px; box-shadow: 0 4px 14px rgba(0,0,0,0.08);">
        <h1 style="margin-top: 0; margin-bottom: 6px;">Generate Report</h1>
        <p style="margin-top: 0; margin-bottom: 18px; color: #555;">ACE SuperMart report center for managers and cashiers.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr auto; gap: 12px; align-items: end; margin-bottom: 18px;">
            <div>
                <label for="reportType" style="display: block; margin-bottom: 6px; font-weight: 600;">Report Type</label>
                <select id="reportType" style="width: 100%; padding: 10px; border: 1px solid #c8d1dc; border-radius: 6px;">
                    <option>Daily Sales</option>
                    <option>Weekly Sales</option>
                    <option>Monthly Sales</option>
                    <option>Refund Summary</option>
                </select>
            </div>

            <div>
                <label for="reportDate" style="display: block; margin-bottom: 6px; font-weight: 600;">Select Date</label>
                <input id="reportDate" type="date" style="width: 100%; padding: 10px; border: 1px solid #c8d1dc; border-radius: 6px;" />
            </div>

            <button type="button" style="padding: 10px 16px; border: none; border-radius: 6px; background-color: #2ea043; color: #ffffff; cursor: pointer; font-weight: 600;">
                Generate Report
            </button>
        </div>

        <div style="border: 1px solid #e2e8f0; border-radius: 10px; padding: 16px; background-color: #f8fafc; margin-bottom: 16px;">
            <h3 style="margin-top: 0; margin-bottom: 12px;">Report Results</h3>
            <div style="display: grid; grid-template-columns: repeat(4, minmax(120px, 1fr)); gap: 10px;">
                <div style="padding: 10px; background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px;">
                    <div style="font-size: 13px; color: #555;">Total Sales</div>
                    <div style="font-size: 20px; font-weight: 700;">$0.00</div>
                </div>
                <div style="padding: 10px; background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px;">
                    <div style="font-size: 13px; color: #555;">Total Transactions</div>
                    <div style="font-size: 20px; font-weight: 700;">0</div>
                </div>
                <div style="padding: 10px; background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px;">
                    <div style="font-size: 13px; color: #555;">Total Refunds</div>
                    <div style="font-size: 20px; font-weight: 700;">$0.00</div>
                </div>
                <div style="padding: 10px; background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px;">
                    <div style="font-size: 13px; color: #555;">Total Discounts</div>
                    <div style="font-size: 20px; font-weight: 700;">$0.00</div>
                </div>
            </div>
        </div>

        <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
            <thead>
                <tr style="background-color: #f4f6f8;">
                    <th style="text-align: left; padding: 12px; border: 1px solid #d8dee5;">Time</th>
                    <th style="text-align: left; padding: 12px; border: 1px solid #d8dee5;">Transaction ID</th>
                    <th style="text-align: left; padding: 12px; border: 1px solid #d8dee5;">Type</th>
                    <th style="text-align: right; padding: 12px; border: 1px solid #d8dee5;">Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td style="padding: 12px; border: 1px solid #e2e8f0;">--:--</td>
                    <td style="padding: 12px; border: 1px solid #e2e8f0;">TXN-0000</td>
                    <td style="padding: 12px; border: 1px solid #e2e8f0;">Sale</td>
                    <td style="padding: 12px; border: 1px solid #e2e8f0; text-align: right;">$0.00</td>
                </tr>
            </tbody>
        </table>

        <a asp-controller="Home" asp-action="Index" style="display: inline-block; padding: 10px 16px; text-decoration: none; border-radius: 6px; background-color: #6c757d; color: #ffffff;">
            Back to Dashboard
        </a>
    </div>
</div>
