@model MongoExample.Models.Transactions

@{
    ViewData["Title"] = "Refund Complete";
}

<div style="min-height: 100vh; background-color: #eef2f7; padding: 24px;">
    <div
        style="width: 100%; max-width: 900px; margin: 0 auto; background: #ffffff; padding: 30px; border-radius: 14px; box-shadow: 0 6px 18px rgba(0,0,0,0.10);">
        <h1 style="margin-top: 0;">Refund Complete</h1>
        <p style="color: #d1242f; font-weight: 600;">Refund issued and recorded successfully.</p>

        <div style="margin-bottom: 20px;">
            <div><strong>Transaction Number:</strong> @Model.transactionNumber</div>
            <div><strong>Original Cashier (Employee ID):</strong> @Model.employeeId</div>
            <div><strong>Original Payment Method:</strong> @Model.paymentMethod</div>
            <div><strong>Original Total:</strong> $@Model.total</div>

            <div style="margin-top: 12px; padding: 10px; border-radius: 8px; background-color: #fff3cd; color: #664d03;">
                <div style="font-weight: 600; margin-bottom: 4px;">Refund Details</div>
                <div><strong>Refund Amount:</strong> $@(Model.refundAmount ?? 0m)</div>
                @if (Model.refundedAt.HasValue)
                {
                    <div><strong>Refunded At (UTC):</strong> @Model.refundedAt.Value.ToString("u")</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.refundedByEmployeeId))
                {
                    <div><strong>Refund Issued By (Employee ID):</strong> @Model.refundedByEmployeeId</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.refundApprovedByEmployeeId))
                {
                    <div><strong>Manager Approval (Employee ID):</strong> @Model.refundApprovedByEmployeeId</div>
                }
                @if (Model.refundApprovedAt.HasValue)
                {
                    <div><strong>Approved At (UTC):</strong> @Model.refundApprovedAt.Value.ToString("u")</div>
                }
            </div>
        </div>

        <h3>Refunded Items</h3>
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
            <thead>
                <tr style="background-color: #eaf0f6;">
                    <th style="text-align: left; padding: 11px; border: 1px solid #cfd8e3;">SKU</th>
                    <th style="text-align: left; padding: 11px; border: 1px solid #cfd8e3;">Name</th>
                    <th style="text-align: center; padding: 11px; border: 1px solid #cfd8e3;">Qty</th>
                    <th style="text-align: right; padding: 11px; border: 1px solid #cfd8e3;">Line Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.items)
                {
                    <tr>
                        <td style="padding: 11px; border: 1px solid #dbe3ec;">@item.sku</td>
                        <td style="padding: 11px; border: 1px solid #dbe3ec;">@item.name</td>
                        <td style="padding: 11px; border: 1px solid #dbe3ec; text-align: center;">@item.quantity</td>
                        <td style="padding: 11px; border: 1px solid #dbe3ec; text-align: right;">$@item.lineTotal</td>
                    </tr>
                }
            </tbody>
        </table>

        <a asp-controller="Home" asp-action="Index"
               style="display: inline-block; padding: 10px 16px; text-decoration: none; border-radius: 6px; background-color: #1f6feb; color: #ffffff;">
            Back to Dashboard
        </a>
    </div>
</div>
