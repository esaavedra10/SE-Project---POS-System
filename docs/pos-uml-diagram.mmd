%% ACE SuperMart POS – ASP.NET Core MVC + MongoDB (from current codebase)
%% Manager: Session "EmployeeRole" = Manager when employee PID starts with "M" (login).
%% Manager gate: ControllerRoleGuards.RequireManagerFromSession on product void only.
%% Manager credentials: EmployeeServices.ValidateManagerCredentialsAsync (PID prefix M) for discounts, refunds, age-restricted approval.

classDiagram
  direction TB

  %% --- MongoDB document models (collections: Employees, Products, Transactions) ---
  class Employees {
    +string Id
    +string name
    +string EID
    +string PID
    +string password
  }

  class Products {
    +string Id
    +string sku
    +string name
    +decimal price
    +int stock
    +bool ageRestricted
    +bool isVoided
    +string voidReason
    +string voidedBy
    +DateTime voidedAt
  }

  class Transactions {
    +string Id
    +string transactionNumber
    +string employeeId
    +items list of TransactionItem
    +decimal subtotal
    +decimal tax
    +decimal total
    +string paymentMethod
    +decimal cashReceived
    +decimal changeDue
    +decimal discountAmount
    +int discountPercent
    +string discountApprovedByEmployeeId
    +DateTime discountApprovedAt
    +decimal refundAmount
    +DateTime refundedAt
    +string refundedByEmployeeId
    +string refundApprovedByEmployeeId
    +DateTime refundApprovedAt
    +DateTime createdAt
  }

  class TransactionItem {
    +string productId
    +string sku
    +string name
    +decimal price
    +int quantity
    +decimal lineTotal
  }

  class MongoDBSettings {
    +string ConnectionURI
    +string DatabaseName
    +string CollectionName
  }

  %% --- Services ---
  class EmployeeServices {
    -IMongoCollection _employeeCollection
    +GetByEmployeeIdAsync()
    +ValidateManagerCredentialsAsync()
    +GetAsync() Employees list
    +CreateAsync() 
    +UpdateAsync() 
    +RemoveAsync() 
  }

  class ProductsServices {
    -IMongoCollection _productsCollection
    +GetBySkuAsync()
    +GetByNameAsync()
    +GetAsync() Products list
    +CreateAsync() 
    +UpdateAsync() 
    +RemoveAsync() 
  }

  class TransactionServices {
    -IMongoCollection _transactionsCollection
    +GetByTransactionNumberAsync()
    +GetByDateRangeAsync() Transactions list
    +CreateAsync() 
    +UpdateAsync() 
  }

  %% --- Extensions ---
  class ControllerRoleGuards {
    <<static>>
    +RequireManagerFromSession()
  }

  %% --- ViewModels ---
  class MakeSaleView {
    +CartItems list
    +decimal Total
    +string PaymentMethod
    +decimal CashReceived
    +string PendingRestrictedSku
    +bool ShowApprovalLogin
    +discount and approval fields
  }

  class SaleCartItem {
    +string sku
    +string name
    +decimal price
    +int quantity
    +decimal lineTotal
  }

  class DailyReportView {
    +DateTime SelectedDate
    +decimal TotalSales
    +decimal TotalRefunds
    +decimal TotalDiscounts
    +int DiscountCount
    +Transactions list
  }

  class RefundView {
    +string OriginalTransactionNumber
    +Transactions OriginalTransaction
    +bool ApprovalGranted
    +refund approval fields
  }

  class ItemLookupView {
    +string SearchTerm
    +Products SelectedProduct
  }

  %% --- Controllers ---
  class AuthController {
    -EmployeeServices _employeeServices
    +Login() GET POST
    +Logout()
    -DetermineRole() string
  }

  class HomeController {
    +Index() dashboard
    +Privacy()
    +Error()
  }

  class SaleController {
    +Index() redirect to MakeSale
  }

  class TransactionsController {
    -TransactionServices _transactionServices
    -ProductsServices _productsServices
    -EmployeeServices _employeeServices
    +MakeSale()
    +AddItem()
    +ConfirmRestricted()
    +VerifyApproval()
    +RemoveItem()
    +RequestDiscountApproval()
    +VerifyDiscountApproval()
    +ApplyDiscountPercent()
    +CompleteSale()
    +SaleComplete()
  }

  class RefundsController {
    -TransactionServices _transactionServices
    -EmployeeServices _employeeServices
    +Lookup()
    +Issue()
    +VerifyRefundApproval()
    +IssueRefund()
    +RefundComplete()
  }

  class ReportsController {
    -TransactionServices _transactionServices
    +Index() GET POST daily aggregates
  }

  class ItemsController {
    -ProductsServices _productsServices
    +Lookup() GET POST
  }

  class ProductsController {
    -ProductsServices _productsServices
    +Index() CRUD views
    +VoidProduct()
  }

  class EmployeesController {
    -EmployeeServices _employeeServices
    +Index() CRUD views
  }

  %% --- Relationships: persistence ---
  EmployeeServices --> MongoDBSettings : IOptions config
  EmployeeServices --> Employees : collection Employees
  ProductsServices --> MongoDBSettings : IOptions config
  ProductsServices --> Products : collection Products
  TransactionServices --> MongoDBSettings : IOptions config
  TransactionServices --> Transactions : collection Transactions

  Transactions *-- TransactionItem : contains

  %% --- Relationships: controllers to services ---
  AuthController --> EmployeeServices
  TransactionsController --> TransactionServices
  TransactionsController --> ProductsServices
  TransactionsController --> EmployeeServices
  RefundsController --> TransactionServices
  RefundsController --> EmployeeServices
  ReportsController --> TransactionServices
  ItemsController --> ProductsServices
  ProductsController --> ProductsServices
  EmployeesController --> EmployeeServices

  ProductsController ..> ControllerRoleGuards : VoidProduct

  %% --- Relationships: views / models ---
  TransactionsController ..> MakeSaleView : MakeSale
  MakeSaleView *-- SaleCartItem
  ReportsController ..> DailyReportView
  RefundsController ..> RefundView
  ItemsController ..> ItemLookupView
  RefundView ..> Transactions : loads
  DailyReportView ..> Transactions : lists

  TransactionsController ..> Transactions : CompleteSale inserts
  RefundsController ..> Transactions : IssueRefund updates

  %% Flow hints (no extra classes)
  note for HomeController "View Home/Index links to Sale, Reports, Items, Refunds, Logout"
  note for ItemsController "View Items/Lookup can post Products/VoidProduct (manager only)"
  note for TransactionsController "Session cart SaleCart; blocks voided or out-of-stock; age-restrict uses manager login"
