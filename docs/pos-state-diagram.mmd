%% ACE SuperMart POS – high-level navigation and sale flow (from current MVC code)
%% Session: EmployeeId, EmployeeName, EmployeeRole. Manager when PID starts with "M" at login.
%% Void: UI only for managers (Items/Lookup). Non-manager POST to Products/VoidProduct -> Forbid (403).
%% Sale: session cart SaleCart; CompleteSale requires login; cash requires CashReceived >= total.

stateDiagram-v2
  direction TB

  [*] --> LoggedOut

  state "Logged Out" as LoggedOut
  state "Login Screen" as LoginScreen
  state "Invalid Login" as InvalidLogin
  state "Authenticated Employee" as AuthEmployee
  state "Authenticated Manager" as AuthManager
  state "Dashboard" as Dashboard
  state "Item Lookup" as ItemLookup
  state "Lookup Results / Item Details" as LookupResults
  state "Access Denied" as AccessDenied
  state "Start Sale" as StartSale
  state "Age-Restricted Gate" as AgeGate
  state "Cart Updated" as CartUpdated
  state "Sale Blocked" as SaleBlocked
  state "Payment Processing" as PaymentProcessing
  state "Transaction Complete" as TxComplete
  state "Reports" as Reports
  state "Logout" as Logout

  LoggedOut --> LoginScreen : app default route Auth/Login

  LoginScreen --> InvalidLogin : wrong id or password
  InvalidLogin --> LoginScreen : retry

  LoginScreen --> AuthManager : valid login PID starts with M
  LoginScreen --> AuthEmployee : valid login other PID

  AuthManager --> Dashboard : redirect Home/Index
  AuthEmployee --> Dashboard : redirect Home/Index

  Dashboard --> ItemLookup : Look Up Item
  ItemLookup --> LookupResults : search POST product found
  ItemLookup --> ItemLookup : search POST no match

  LookupResults --> LookupResults : search again
  LookupResults --> Dashboard : Back to Dashboard
  LookupResults --> ItemLookup : manager void success Products/VoidProduct

  LookupResults --> AccessDenied : non-manager POST VoidProduct
  note right of AccessDenied : HTTP 403 Forbid via RequireManagerFromSession

  AccessDenied --> Dashboard : user navigates away

  Dashboard --> StartSale : Start Sale to MakeSale

  StartSale --> SaleBlocked : voided product
  StartSale --> SaleBlocked : out of stock
  StartSale --> StartSale : SKU or name not found
  SaleBlocked --> StartSale : correct item or message cleared

  StartSale --> AgeGate : age-restricted product Approve
  AgeGate --> StartSale : Reject or bad manager login
  AgeGate --> CartUpdated : manager VerifyApproval OK

  StartSale --> CartUpdated : item added sellable
  CartUpdated --> StartSale : add more remove items discounts

  CartUpdated --> PaymentProcessing : Complete Sale submit
  PaymentProcessing --> StartSale : cart empty or cash lt total
  PaymentProcessing --> LoginScreen : session missing
  PaymentProcessing --> TxComplete : MongoDB insert stock update

  TxComplete --> Dashboard : back link
  TxComplete --> StartSale : new sale link

  Dashboard --> Reports : Generate Report
  Reports --> Dashboard : back link

  Dashboard --> Logout
  Logout --> LoggedOut : Auth/Logout clears session
